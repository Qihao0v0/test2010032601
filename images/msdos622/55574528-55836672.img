┼   ┬┬┬─┼╞╞╟╞╟╟╟╟╟╟┼╞╟╚╚╓╪╪╪╪╪╪╪╪╪╪╪╪╪╫╫╫╪╪╪╪╪╪╪╪╓╘┬┬┬┬┬┬─┼╞╞╟╟╚╚╚╚╞─├├├┬─╚╓╫╫╓╫╓╓╓╓╓╪╪╪╫╫╪╪╪╪╪╪╪╪╪╫╓┬  ┬┬┬─╞╟╟╟╚╚╚╚╚╞├┬   ┼╘╒╓╓╓╓╓╒╒╒╒╓╪╪╪╪╪╪╪╪┘╪╪╪╪╪╫┬    ┬┼╞╟╚╚╚╚╘╘╟├     ─╒╓╓╘╒╫╓╒╘╘╘╘╒╪╪╪╪╪╪┘╪╪╪╪╪╪╘├     ─╟╟╟╟╚╚╘╘╚├    ┬╚╓╓╓╚╚╘╪╫╓╘╘╚╘╓╪┘┘╪╪╪╪╪╪╪╪╪╓├      ├──╞╟╘╒╓╒┬    ┼╓╪╪╪╪╒╟╚╘╫╓╒╘╘╓╪╪╪╪╪╪╪╪╪╪╪╪╓├       ├─╞╟╟╘╘┼     ─╘╓╓╫╫╘─┬─╚╘╘╓╓╫╪╪╪╪╪╪┘╪╪╪╪╪╫├       ├├├├──├    ├─┼╟╚╚╘╚─├─┼╘╚╘╓╓╫╫╪╪╪╪┘╪╪┘╪╪╪╫├        ┬┬ ┬┬      ┬├─┼╞╟┼├├╟╘╓╓╚╘╓╪╪╫╪╪╪╪┘╪┘╪╪╪╓├                     ┬├├├┬┬├╞╘╓╘╚╚╓╪╪╪╪╪╪╪┘╪┘╪╪╪╒├                ┬      ┬┬┬├──╚╘╘╟╞╚╓╪╪╪╪╪╪┘┘╪┘╪╪╓─              ┬├├┬     ┬┬├─┼╟╚╚╞──╟╓╪╪╪╪╪╪┘┘╪╪╪╪╪╞              ┬─┼─┬┬┬┬├├┬┬├├─┼┼──╞╘╫╪┘╪┘┘╪╪╪╪╪╪╪╪╞          ┬├───╟╚╟┼─├─╞╚╞┬  ┬─┼╟╟╚╓╪┘╪┘╪┘╪╪╪╪╪╪╪╪┼          ┬┬┼╞╞╟╚╚╟╟╞┼╚╒╘╞├  ┬├╚╓╪╪┘┘╪╪╪╪┘╪╪╫╪╪╪╓├          ┬├──├─┼╟╟╟╟╞╟╚╟┼├ ┬├┼╘╪╪┘┘┘╪╪╪╪╪╪╫╓╪╪╪╞├           ┬┬┬┬├├─────┼─├├├┬├┼╚╓╫╪╪╪╪╪╪╪╪╪╫╫╓╪╪╪╟┬           ┬┬┬┬├├─├├├├─├├├┬├├╟╘╓╒╓╫╫╫╫╫╫╪╫╫╪╪╪╪╪╓┬           ┬┬┬┬┬├├├├├├├├┬┬┬┬─╟╚╘╘╒╓╓╓╓╫╫╪╪╪╪╪╪╪╪╫┬               ┬┬┬┬├├┬┬┬┬┬┬├─╞╟╟╚╚╚╘╒╘╓╫╪╪╪╪╫╫╓╒╟┬               ┬┬┬┬┬┬┬┬┬ ┬┬├├┼┼╞╟╟╘╘╘╒╓╓╫╫╫╫╓╒╚┼├             ┬├┬┬┬├├├┬┬├┬┬┬┬├├───┼╟╚╚╘╘╓╓╓╓╫╓╘╟─               ┬┬┬├├──├┬┬   ┬┬┬├├──┼╞╚╘╓╓╓╓╓╓╓╘╞┬                 ┬┬├├├──├├├┬ ┬┬├├─┼┼╞╚╘╓╓╓╓╓╒╒╘╞┬                  ┬┬┬├├├├├├─├┬├├├──┼╞╟╚╘╒╒╒╘╘╚╟┼┬                    ┬┬┬├├─┼┼──┬├├├───╞╟╚╘╘╘╘╚╟├┬                         ┬├├├─├┬┬┬├├├├─┼╟╚╚╟╟╞─                            ┬┬├├┬   ┬┬├├──┼╞╟╚┼─                               ┬┬   ┬┬┬├├├├─┼╞╞─┬                                 ┬┬┬┬┬  ┬┬┬├──┼├                                   ┬┬┬├┬   ┬┬┬─┼├                                       ┬┬  ┬├──┬                                         ┬┬┬├├╞┼├                                         ┬┬├─┼┼┼─                                           ┬├├─┼─                                                ├┬                                                                   ╞╟                                                                        ╪╪╫╟                                                                   ╚╞ ╒╪╪╪╘